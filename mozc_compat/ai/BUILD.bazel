# Copyright 2024 AI Mozc IME Project
# AI Module BUILD file for Mozc integration

load(
    "//:build_defs.bzl",
    "mozc_cc_library",
    "mozc_cc_test",
)

package(default_visibility = ["//visibility:public"])

mozc_cc_library(
    name = "ai_config",
    srcs = ["ai_config.cc"],
    hdrs = ["ai_config.h"],
)

mozc_cc_test(
    name = "ai_config_test",
    size = "small",
    srcs = ["ai_config_test.cc"],
    deps = [
        ":ai_config",
        "//testing:gunit_main",
    ],
)

mozc_cc_library(
    name = "ai_logger",
    srcs = ["ai_logger.cc"],
    hdrs = ["ai_logger.h"],
    deps = [
        ":ai_config",
    ],
)

mozc_cc_library(
    name = "ai_candidate_cache",
    srcs = ["ai_candidate_cache.cc"],
    hdrs = ["ai_candidate_cache.h"],
    deps = [
        ":ai_config",
    ],
)

mozc_cc_test(
    name = "ai_candidate_cache_test",
    size = "small",
    srcs = ["ai_candidate_cache_test.cc"],
    deps = [
        ":ai_candidate_cache",
        "//testing:gunit_main",
    ],
)

mozc_cc_library(
    name = "ai_backend",
    srcs = [
        "mock_backend.cc",
        "ollama_backend.cc",
        "openai_compatible_backend.cc",
    ],
    hdrs = ["ai_backend.h"],
    deps = [
        ":ai_config",
        ":ai_logger",
    ],
)

mozc_cc_test(
    name = "ai_backend_test",
    size = "small",
    srcs = ["ai_backend_test.cc"],
    deps = [
        ":ai_backend",
        "//testing:gunit_main",
    ],
)

mozc_cc_library(
    name = "ai_worker",
    srcs = ["ai_worker.cc"],
    hdrs = ["ai_worker.h"],
    deps = [
        ":ai_backend",
        ":ai_candidate_cache",
        ":ai_config",
        ":ai_logger",
    ],
)

mozc_cc_test(
    name = "ai_worker_test",
    size = "medium",
    srcs = ["ai_worker_test.cc"],
    deps = [
        ":ai_worker",
        "//testing:gunit_main",
    ],
)

mozc_cc_library(
    name = "ai",
    deps = [
        ":ai_backend",
        ":ai_candidate_cache",
        ":ai_config",
        ":ai_logger",
        ":ai_worker",
    ],
)
