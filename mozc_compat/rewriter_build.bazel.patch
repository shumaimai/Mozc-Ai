# AI Rewriter - add to mozc/src/rewriter/BUILD.bazel

mozc_cc_library(
    name = "ai_rewriter",
    srcs = ["ai_rewriter.cc"],
    hdrs = ["ai_rewriter.h"],
    deps = [
        ":rewriter_interface",
        "//ai:ai_backend",
        "//ai:ai_candidate_cache",
        "//ai:ai_config",
        "//ai:ai_logger",
        "//ai:ai_worker",
        "//converter:segments",
        "//request:conversion_request",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/strings",
    ],
    alwayslink = 1,
)

mozc_cc_test(
    name = "ai_rewriter_test",
    size = "enormous",
    timeout = "eternal",
    srcs = ["ai_rewriter_test.cc"],
    deps = [
        ":ai_rewriter",
        "//converter:segments",
        "//request:conversion_request",
        "//testing:gunit_main",
    ],
)

# Also add ":ai_rewriter" to the deps of the "rewriter" target.
