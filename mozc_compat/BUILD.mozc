# Copyright 2024 AI Mozc IME Project
# AI Module BUILD file for Mozc integration
#
# Usage:
#   1. Copy this file to mozc/src/ai/BUILD
#   2. Ensure //bazel:stubs.bzl exists in Mozc source
#   3. Run: bazelisk build //ai:all

load("//bazel:stubs.bzl", "bzl_library", "cc_library_mozc", "cc_test_mozc")

package(default_visibility = ["//visibility:public"])

# ============================================================================
# AI Configuration
# ============================================================================

cc_library_mozc(
    name = "ai_config",
    srcs = ["ai_config.cc"],
    hdrs = ["ai_config.h"],
    deps = [
        "//base:logging",
        "//base:port",
    ],
)

cc_test_mozc(
    name = "ai_config_test",
    srcs = ["ai_config_test.cc"],
    deps = [
        ":ai_config",
        "//testing:gunit_main",
    ],
)

# ============================================================================
# AI Logger
# ============================================================================

cc_library_mozc(
    name = "ai_logger",
    srcs = ["ai_logger.cc"],
    hdrs = ["ai_logger.h"],
    deps = [
        ":ai_config",
        "//base:logging",
    ],
)

# ============================================================================
# AI Candidate Cache
# ============================================================================

cc_library_mozc(
    name = "ai_candidate_cache",
    srcs = ["ai_candidate_cache.cc"],
    hdrs = ["ai_candidate_cache.h"],
    deps = [
        ":ai_config",
    ],
)

cc_test_mozc(
    name = "ai_candidate_cache_test",
    srcs = ["ai_candidate_cache_test.cc"],
    deps = [
        ":ai_candidate_cache",
        "//testing:gunit_main",
    ],
)

# ============================================================================
# AI Backend
# ============================================================================

cc_library_mozc(
    name = "ai_backend",
    srcs = [
        "mock_backend.cc",
        "ollama_backend.cc",
    ],
    hdrs = ["ai_backend.h"],
    deps = [
        ":ai_config",
        ":ai_logger",
    ],
)

cc_test_mozc(
    name = "ai_backend_test",
    srcs = ["ai_backend_test.cc"],
    deps = [
        ":ai_backend",
        "//testing:gunit_main",
    ],
)

# ============================================================================
# AI Worker
# ============================================================================

cc_library_mozc(
    name = "ai_worker",
    srcs = ["ai_worker.cc"],
    hdrs = ["ai_worker.h"],
    deps = [
        ":ai_backend",
        ":ai_candidate_cache",
        ":ai_config",
        ":ai_logger",
    ],
)

cc_test_mozc(
    name = "ai_worker_test",
    srcs = ["ai_worker_test.cc"],
    deps = [
        ":ai_worker",
        "//testing:gunit_main",
    ],
)

# ============================================================================
# Combined AI Module
# ============================================================================

cc_library_mozc(
    name = "ai",
    deps = [
        ":ai_backend",
        ":ai_candidate_cache",
        ":ai_config",
        ":ai_logger",
        ":ai_worker",
    ],
)
