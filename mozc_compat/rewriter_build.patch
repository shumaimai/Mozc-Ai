# AI Rewriter BUILD patch for Mozc
#
# Add this section to mozc/src/rewriter/BUILD
# Location: End of file, before any closing statements

# ============================================================================
# AI Rewriter - AI-powered candidate suggestions
# ============================================================================

cc_library_mozc(
    name = "ai_rewriter",
    srcs = ["ai_rewriter.cc"],
    hdrs = ["ai_rewriter.h"],
    deps = [
        ":rewriter_interface",
        "//ai:ai_backend",
        "//ai:ai_candidate_cache",
        "//ai:ai_config",
        "//ai:ai_logger",
        "//ai:ai_worker",
        "//base:logging",
    ],
)

cc_test_mozc(
    name = "ai_rewriter_test",
    size = "enormous",
    timeout = "eternal",
    srcs = ["ai_rewriter_test.cc"],
    deps = [
        ":ai_rewriter",
        ":rewriter_interface",
        "//testing:gunit_main",
    ],
)
